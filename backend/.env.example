# IP-SAKTI Environment Configuration Template
# ==============================================================================
# Operational Modes:
# - DEVELOPMENT: DATABASE_MODE=mock, STORAGE_MODE=mock, APP_ENV=development
# - PRODUCTION:  DATABASE_MODE=firestore, STORAGE_MODE=backblaze, APP_ENV=production
# ==============================================================================

# Server & Environment
HOST=0.0.0.0
PORT=8000
DEBUG=False
APP_ENV=development # 'development' or 'production'

# Explicit Operational Modes
DATABASE_MODE=mock   # 'mock' (local JSON) or 'firestore' (Firebase Cloud Firestore)
STORAGE_MODE=mock    # 'mock' (local disk) or 'backblaze' (Backblaze B2 Object Storage)
RAG_MODE=mock        # 'mock' or 'production'
VOICE_PROVIDER=bhashini # 'bhashini' or 'mock'

# Primary LLM Engine (Groq API - Mandatory for text reasoning)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Secondary Fallback Vision/OCR Engine (Ollama / Gemma 4 12B)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:12b
OLLAMA_TIMEOUT_SECONDS=120.0

# BHASHINI API Credentials (Dhruva / Udyat Pipeline)
BHASHINI_UDYAT_KEY=your_bhashini_udyat_key_here
BHASHINI_INFERENCE_KEY=your_bhashini_inference_key_here
BHASHINI_API_KEY=
BHASHINI_USER_ID=
BHASHINI_BASE_URL=https://dhruva-api.bhashini.gov.in/services/inference
BHASHINI_PIPELINE_ID=
BHASHINI_ASR_SERVICE_ID=
BHASHINI_OCR_SERVICE_ID=
BHASHINI_NMT_SERVICE_ID=
BHASHINI_TTS_SERVICE_ID=

# Firebase Firestore (Required when DATABASE_MODE=firestore or APP_ENV=production)
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_CREDENTIALS_PATH=
FIREBASE_CREDENTIALS_JSON=

# Backblaze B2 Storage (Required when STORAGE_MODE=backblaze or APP_ENV=production)
B2_APPLICATION_KEY_ID=your_b2_application_key_id_here
B2_APPLICATION_KEY=your_b2_application_key_here
B2_BUCKET_NAME=IP-SAKTI
B2_ENDPOINT_URL=https://s3.us-west-004.backblazeb2.com

# Vector DB / Knowledge Base
VECTOR_DB_TYPE=memory
VECTOR_DB_PERSIST_PATH=./data/vector_index
# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://ip-sakti.vercel.app
CORS_ORIGINS=
