# ==============================================================================
# IP-SAKTI SAHAYAK — RENDER BACKEND ENVIRONMENT CONFIGURATION (.env)
# ==============================================================================
# Instructions for Render:
# 1. In your Render Web Service dashboard, go to the "Environment" tab.
# 2. Click "Add Environment Variable" or click "Bulk Edit" / "Add from .env".
# 3. Paste the contents below (make sure to replace GROQ_API_KEY with your actual key).
# ==============================================================================

# Operational Mode & Server Config
APP_ENV=production
DEBUG=false
HOST=0.0.0.0
PORT=8000

# Explicit Operational Modes
DATABASE_MODE=mock
STORAGE_MODE=mock
RAG_MODE=mock

# Primary LLM Engine (Groq API)
LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# CORS Configuration (Specify explicit frontend domains in production)
CORS_ALLOWED_ORIGINS=https://ip-sakti.vercel.app,http://localhost:3000
CORS_ORIGINS=

# Optional: BHASHINI API Credentials (if using Bhashini Voice/ASR/TTS)
BHASHINI_UDYAT_KEY=
BHASHINI_INFERENCE_KEY=
BHASHINI_BASE_URL=https://dhruva-api.bhashini.gov.in/services/inference
BHASHINI_PIPELINE_ID=

# Optional: Cloud Database & Storage (Leave blank if DATABASE_MODE=mock)
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS_JSON=
B2_APPLICATION_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET_NAME=IP-SAKTI
B2_ENDPOINT_URL=https://s3.us-west-004.backblazeb2.com
