NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_web_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=ip-sakti-sih.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=ip-sakti-sih
